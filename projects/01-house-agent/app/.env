# 公开配置：密钥、口令已清空。复制为 .env.local 后填写真实值。
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bitehouse_prd
REDIS_URI=redis://:REPLACE_ME@host.docker.internal:6380/0
DATABASE_URI=postgresql://postgres:REPLACE_ME@host.docker.internal:5432/postgres

# 模型通过 OpenAI 兼容接口调用 OpenRouter。
LLM_MODEL=openai/gpt-4o-mini
